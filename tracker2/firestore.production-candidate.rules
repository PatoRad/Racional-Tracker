// CANDIDATO NO DESPLEGADO. Prueba ambas áreas antes de aplicar reglas en producción.
// Prototipo NO desplegado. Revisar y probar antes de adopción.
// Modelo: users/{uid}/portfolios/main {schemaVersion:2, revision:int >=1}.
// movements/{id}: tipo enum, monto number +/-1e12 (positivo salvo rendimiento),
// desc string 1..500, fecha timestamp 1900..2200, hora HH:mm o vacía,
// clp/tc/acciones number 0..1e12, etf string <=30, orden int 0..1e15.
// trackerAccess es un custom claim emitido solo por administración; no por documentos.
// No se almacenan roles ni UID proporcionados por el cliente.
// Toda escritura de movimientos requiere avanzar la revisión en la misma operación.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.trackerAccess == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isValidMeta(data) {
      return data.keys().hasOnly(['schemaVersion','revision']) &&
        data.keys().hasAll(['schemaVersion','revision']) &&
        data.schemaVersion == 2 && data.revision is int &&
        data.revision >= 1 && data.revision <= 9007199254740991;
    }
    function isValidMovement(data) {
      return data.keys().hasOnly(['tipo','monto','desc','fecha','hora','clp','tc','etf','acciones','orden']) &&
        data.keys().hasAll(['tipo','monto','desc','fecha','hora','clp','tc','etf','acciones','orden']) &&
        data.tipo in ['aporte','compra','venta','rendimiento','dividendo','retiro','comision','rebalanceo'] &&
        data.monto is number && data.monto >= -1000000000000 && data.monto <= 1000000000000 &&
        (data.tipo == 'rendimiento' || data.monto > 0) &&
        data.desc is string && data.desc.size() >= 1 && data.desc.size() <= 500 &&
        data.fecha is timestamp &&
        data.fecha == data.fecha.date() &&
        data.fecha >= timestamp.date(1900,1,1) && data.fecha < timestamp.date(2201,1,1) &&
        data.hora is string && (data.hora == '' || data.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')) &&
        data.clp is number && data.clp >= 0 && data.clp <= 1000000000000 &&
        data.tc is number && data.tc >= 0 && data.tc <= 1000000000000 &&
        data.acciones is number && data.acciones >= 0 && data.acciones <= 1000000000000 &&
        data.etf is string && data.etf.size() <= 30 &&
        data.orden is int && data.orden >= 0 && data.orden <= 1000000000000000;
    }
    function advancesRevision(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/portfolios/main;
      let after = getAfter(path).data;
      return isValidMeta(after) &&
        after.revision == (exists(path) ? get(path).data.revision + 1 : 1);
    }
    match /users/{uid}/portfolios/{portfolioId} {
      allow read: if portfolioId == 'main' && isOwner(uid);
      allow create: if portfolioId == 'main' && isOwner(uid) &&
        isValidMeta(request.resource.data) && request.resource.data.revision == 1;
      allow update: if portfolioId == 'main' && isOwner(uid) &&
        isValidMeta(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
      match /movements/{id} {
        allow read: if portfolioId == 'main' && isOwner(uid);
        allow create, update: if portfolioId == 'main' && isOwner(uid) &&
          id.matches('^[A-Za-z0-9_-]{8,64}$') &&
          isValidMovement(request.resource.data) && advancesRevision(uid);
        allow delete: if portfolioId == 'main' && isOwner(uid) && advancesRevision(uid);
      }
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.auth.token.trackerAccess == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validId(id) { return id.matches('^[A-Za-z0-9_-]{3,80}$'); }
    function metaOk(d) {
      return d.keys().hasAll(['schemaVersion','revision']) &&
        d.keys().hasOnly(['schemaVersion','revision']) &&
        d.schemaVersion == 1 && d.revision is int && d.revision >= 1 && d.revision < 9007199254740991;
    }
    function changed(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/financeV2/state;
      let after = getAfter(p).data;
      return metaOk(after) && after.revision == (exists(p) ? get(p).data.revision + 1 : 1);
    }
    function money(n,zero) {
      return n is int && n >= (zero ? 0 : 1) && n <= 1000000000000;
    }
    function accountOk(d) {
      return d.keys().hasAll(['name','type','currency','openingBalance']) &&
        d.keys().hasOnly(['name','type','currency','openingBalance']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
        d.type in ['checking','cash','wallet','savings'] &&
        d.currency in ['CLP','USD'] && money(d.openingBalance,true);
    }
    function movementOk(d) {
      return d.keys().hasAll(['date','type','amount','note','category','source']) &&
        d.keys().hasOnly(['date','type','amount','note','category','source','accountId','fromId','toId','toAmount','provider','externalId']) &&
        d.type in ['income','expense','transfer','yield'] &&
        d.date is string && d.date.matches('^(20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}$') &&
        money(d.amount,false) && d.note is string && d.note.size() <= 200 &&
        d.category is string && d.category.size() <= 60 &&
        d.source in ['manual','demo','bank_import','bank_api'] &&
        ((d.source in ['manual','demo'] && !d.keys().hasAny(['provider','externalId'])) ||
          (d.source in ['bank_import','bank_api'] &&
            d.keys().hasAll(['provider','externalId']) &&
            d.provider is string && d.provider.matches('^[A-Za-z0-9._-]{2,60}$') &&
            d.externalId is string && d.externalId.size() > 0 && d.externalId.size() <= 160)) &&
        ((d.type == 'transfer' && d.keys().hasAll(['fromId','toId']) &&
            !d.keys().hasAny(['accountId']) && validId(d.fromId) && validId(d.toId) &&
            d.fromId != d.toId && (!d.keys().hasAny(['toAmount']) || money(d.toAmount,false))) ||
          (d.type != 'transfer' && d.keys().hasAll(['accountId']) && validId(d.accountId) &&
            !d.keys().hasAny(['fromId','toId','toAmount']) && d.category.size() > 0));
    }
    match /users/{uid}/financeV2/{document} {
      allow read: if document == 'state' && owner(uid);
      allow create: if document == 'state' && owner(uid) && metaOk(request.resource.data) && request.resource.data.revision == 1;
      allow update: if document == 'state' && owner(uid) && metaOk(request.resource.data) && metaOk(resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
      match /accounts/{id} {
        allow read: if document == 'state' && owner(uid);
        allow create, update: if document == 'state' && owner(uid) && validId(id) && accountOk(request.resource.data) && changed(uid);
        allow delete: if false; // Nunca borrar cuentas por accidente; archivado por diseñar.
      }
      match /transactions/{id} {
        allow read: if document == 'state' && owner(uid);
        allow create, update: if document == 'state' && owner(uid) && validId(id) && movementOk(request.resource.data) && changed(uid);
        allow delete: if document == 'state' && owner(uid) && changed(uid);
      }
    }

    match /{path=**} { allow read, write: if false; }
  }
}